# 后端通过 config.yaml 的 backends.list 配置（权重负载均衡）
ALLOW_DYNAMIC_BACKEND=true
# Set to 0 or a negative value to disable automatic cleanup.
RETENTION_DAYS=14
MAX_REQUEST_BYTES=33554432
MAX_CAPTURE_BYTES=33554432
REQUEST_TIMEOUT_SECONDS=600
POLL_BACKEND_METRICS=true
POLL_INTERVAL_SECONDS=10

# YAML 配置文件路径（可选）。设置后优先从该文件加载配置，环境变量仍可覆盖。
# CONFIG_PATH=config.yaml

# 数据库配置（可选，默认使用 SQLite）
# DATABASE_TYPE=postgresql
# DATABASE_DSN=postgres://user:password@localhost:5432/monitor?sslmode=disable
